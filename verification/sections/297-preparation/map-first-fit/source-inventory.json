  "visual_observations_not_calibration": {
    "ro6_c_2": "Visible broad checkerboard/wood frame across multiple rows and columns. Avoid raised grass squares and start/end frames. Promising for a newly frozen ground-only candidate, not proven correspondence.",
    "ro6_c_4": "Visible bottom horizontal wooden ground strip and separated vertical ground lanes. Multiple-row checks are essential; a single bottom row cannot certify depth.",
    "ro6_t_7": "Viewed original; substantial tall figures/fixtures obscure grid cues, so not first choice for a fresh whole-plane attempt.",
    "ro6_n_5_6": "Viewed original; highland platforms and water/vegetation complicate ground anchors, so not first choice.",
    "ro6_b_2": "Viewed original; many ground roads but grass/fixtures interrupt exact corner cues. Reserve after clearer sources."
  },
  "minimum_acceptance_plan": [
    "Freeze one new candidate source packet before any fit: exact PNG SHA/blob/size, complete original level SHA, map/tiles/grid SHA, and exact stage identity.",
    "Record ground-only seam/corner anchors and a separate heldout center set. At least four non-collinear fit correspondences and five heldout centers are the current minimum; holdouts must span rows/columns and left/right/top/bottom usable ground, with zero fit/check reuse.",
    "Obtain independent original-image observations without showing fit/matrix/projected dots or author pixel coordinates. Null/obscured points remain rejected; no average, retuning, RANSAC exclusion or check-set shrink after seeing errors.",
    "Least-squares homography consumes only the pre-frozen fit set. Every heldout must satisfy the existing <=4 original-pixel Euclidean gate. Preserve the original failed attempt if any; do not convert known rejected candidates into pass by selecting nicer points.",
    "Validate public resolver with pinned source identities, stale/alias/geometry rejection and unchanged existing regular/direct dictionaries. An alias needs its own explicit image/grid/level proof.",
    "Only after actual ground reference acceptance plus required UI scaling/selection/refresh checks can regular gap decrease. A direct-only fallback must leave 81/59 unchanged.",
    "Ground-plane acceptance does not validate highland surfaces, decorative roofs, entry footpoints, spawn offsets, random ranges, actual enemy location or timing."
  ],
  "conditional_scope_if_both_candidates_pass": {
    "new_distinct_bitmaps": 2,
    "new_stage_ids": 2,
    "regular_gap_would_be": [
      79,
      57
    ],
    "is_actual_completed_scope": false
  },
  "wrong_premise_risks": [
    "Two readers agreeing on direct centers does not prove a whole-plane homography, inverse, intermediate route segments or absolute game-position accuracy.",
    "A passing sample set does not mean every tile/height is verified; existing single-column/partial coverage still leaves lateral extrapolation gaps.",
    "Current saved old fits are genuine rejections at their recorded points. New implementation work alone supplies no new geometric evidence.",
    "No previously accepted direct image/point is counted as new; this research adds zero accepted coordinates."
  ],

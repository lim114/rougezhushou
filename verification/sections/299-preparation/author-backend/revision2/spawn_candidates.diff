+def _snapshot_digest(packet):
+    """Only the selected query snapshot, preserving exact JSON value types."""
+    selected = {'stage': packet['stage'], 'expected_stage': packet['expected_stage'],
+                'global_source': packet['battle']['source'], 'manifest': packet['manifest']}
+    def check(value):
+        if type(value) is dict:
+            if any(type(key) is not str for key in value): raise ValueError('Non-JSON snapshot key')
+            for child in value.values(): check(child)
+        elif type(value) is list:
+            for child in value: check(child)
+        elif value is not None and type(value) not in (str, int, float, bool):
+            raise ValueError('Non-JSON snapshot value')
+    check(selected)
+    return _sha(json.dumps(selected, ensure_ascii=False, sort_keys=True,
+                           separators=(',', ':'), allow_nan=False).encode('utf8'))
 

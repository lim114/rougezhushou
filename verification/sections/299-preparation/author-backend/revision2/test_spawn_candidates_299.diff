+    def test_22_warm_member_group_and_unexpected_token_mutation_fail_closed(self):
+        for mutation in ('member', 'group', 'token', 'bool_for_int', 'non_json_type', 'nan'):
+            with self.subTest(mutation=mutation):
+                self.subject._CACHE.clear()
+                original = self.action(); token = original['groups'][0]['members'][0]['token']
+                cached = next(iter(self.subject._CACHE.values()))
+                member = cached['stage']['groups'][0]['members'][0]
+                if mutation == 'member': member['display_name'] = '不属于原资料的名称'
+                elif mutation == 'group': cached['stage']['groups'].append(deepcopy(cached['stage']['groups'][0]))
+                elif mutation == 'token': member['token'] = {'kind': 'injected_internal_token'}
+                elif mutation == 'bool_for_int': member['declared_count'] = True
+                elif mutation == 'non_json_type': member['enemy_references'] = tuple(member['enemy_references'])
+                elif mutation == 'nan': member['declared_count'] = float('nan')
+                try:
+                    failed = self.subject.action_reference('ro6_n_2_1', 'w1.f4.a1')
+                    self.assertEqual(failed['status'], 'source_unavailable')
+                    self.assertFalse(failed['source_valid']); self.assertEqual(failed['groups'], [])
+                    self.assertIsNone(self.subject.resolve_reference(token))
+                finally:
+                    self.subject._CACHE.clear()
+        self.assertTrue(self.action()['source_valid'])

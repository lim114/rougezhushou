+        'entrypoints':{'declare':'declare_freeze305.py','activate':'activate_full305.py','execute_explicit_root_owned_wrapper':'run_owned_full305_root.py','archive':'archive_full305.py'},
+        'run_plan':'RUN_PLAN_ATTEMPT2.md','source_receipt_contract':'SOURCE_AND_RECEIPT_SCHEMA_ATTEMPT2.md',
+        'first_archive_or_final_maintenance_PASS_invented':False,'second_input_freeze_activation_execution_started':False,'actual_full305_second_PASS':None}
+    write_new(READY_PATH,ready)
+    print(json.dumps({'ready':str(READY_PATH),'sha256':sha(READY_PATH),'files':len(files),'static_checks':len(checks),'actual_selectors':len(selectors),'runtime_started':False},ensure_ascii=False))
+
+
+if __name__=='__main__':main()

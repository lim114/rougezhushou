  "originals": {
    "scenes": {
      "scene_ro6_hire1_enter": {
        "id": "scene_ro6_hire1_enter",
        "title": "临时中介所",
        "description": "“朋友，你一定需要帮手。”一只穿着得体的鹰攫住了你的手腕，让你一时挣脱不开。愉快的玩闹声从它身后传来，吸引了你的注意——一群动物正在翻滚打闹，浑然不觉它们已经被圈在了栅栏里，成了被兜售的对象。“它们都很有活力吧？不眠不休地工作一个月也不会出问题。请放心，这绝不是什么夸大其词的广告，我们亲手测试过......是的，每一个。”",
        "background": "pic_rogue_6_19",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_hire1_1": {
        "id": "scene_ro6_hire1_1",
        "title": "临时中介所",
        "description": "你带走了一只小动物。它喜极而泣，围着你转了好几圈，这时你才发现它的腿有被打断过的痕迹。“你救了它。”那只鹰的声音从你背后传来，“现在你怎么对待它都可以。”",
        "background": "pic_rogue_6_19",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_hire1_2": {
        "id": "scene_ro6_hire1_2",
        "title": "临时中介所",
        "description": "你凑近栅栏，闻到了被掩盖在草木香气中的血和排泄物的气味。你猜测它们过得很糟，但那只鹰的利爪警示你，你只能带走一只。走吧，至少这个被选中的幸运儿会感激你。",
        "background": "pic_rogue_6_19",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_hire1_3": {
        "id": "scene_ro6_hire1_3",
        "title": "临时中介所",
        "description": "“既然吸引不了主顾，这个地方也不必经营下去了。”转身离去后，你听到燃烧声、哭声还有扑扇翅膀的声音从你背后传来。此时你已经走远，树木遮挡了你的视线，你抬头，看到那只鹰正带着修建栅栏的材料飞走。你有预感，今后你还会见到很多个“临时中介所”。",
        "background": "pic_rogue_6_19",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      }
    },

  "originals": {
    "scenes": {
      "scene_ro6_end4_enter": {
        "id": "scene_ro6_end4_enter",
        "title": "大红按钮",
        "description": "一路上，你们见到了许多大大小小的神庙，那名青年探险家滔滔不绝地向你解说了许多他对玻利瓦尔失落古文明所做的考据。据他研究，那块金色的石板发出的光芒正是指引方位的信标，而他想要与你分享证实玻利瓦尔古文明之存在的殊荣。此刻，你们进入了一座巨型神庙的内部，石板最后发出的光芒落在一个大红按钮上。",
        "background": "pic_rogue_6_45",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end4_1": {
        "id": "scene_ro6_end4_1",
        "title": "大红按钮",
        "description": "按下按钮之后，许多像是档案柜一样的东西从地面升起。赤金、宝石，还有刻着奇妙纹路的石板从那些满满当当的档案柜中溢出。“我想我就快找到了！”那名探险家兴奋地追着怀中金色石板发出的光芒四处翻找，一下子就不见了人影。或许是你的错觉，那名青年的身形好像变得有些陌生。但眼下更麻烦的是，你发现有许多不怀好意的身影正从暗处向你们逼近……",
        "background": "pic_rogue_6_45",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end4_2": {
        "id": "scene_ro6_end4_2",
        "title": "大红按钮",
        "description": "你不认为随意触碰一个大红按钮会是什么好主意，或者至少也得先做好万全的准备。但说到底，为什么一座古代遗迹中会有这种东西？",
        "background": "pic_rogue_6_45",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end5_enter": {
        "id": "scene_ro6_end5_enter",
        "title": "制图桌",
        "description": "尽管一路上发现了若干座奇特的石质建筑，你们却鲜少发现明确带有古文明的人们生活痕迹的物件，甚至在对一些文物的解读上出现了严重的分歧。而当你们发现这样一张奇妙的制图桌时，恐怕就更难以统一意见了。",
        "background": "pic_rogue_6_46",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end5_1": {
        "id": "scene_ro6_end5_1",
        "title": "制图桌",
        "description": "你意识到涂鸦描绘的画面与刚才经过的一处遗迹的死路尽头很像，这或许是一张藏宝图！于是你们立刻动身，成功在石雕之间的土地里挖出了一个看上去就装着贵重物品的箱子，并忙不迭地打开了它。看来无论古文明是否真实存在，至少还有这样的经典寻宝环节可以体验，不是吗？",
        "background": "pic_rogue_6_46",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end5_2": {
        "id": "scene_ro6_end5_2",
        "title": "制图桌",
        "description": "这些图纸上似乎描摹了一些黑流树海中的生物，甚至还进行了一些像是与解剖学相关的研究，但上面记载的文字却不属于任何你们所了解的语言。可当你与那名青年探险家想要进一步仔细查看，触碰到那些纸张时，那些文字所传达的信息以一种混沌的方式直接地灌进了你们的脑海中，像是在一瞬间被迫记住了一篇连语法都无法理解的论文，强烈的眩晕感使你们几乎站不稳。",
        "background": "pic_rogue_6_46",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end5_3": {
        "id": "scene_ro6_end5_3",
        "title": "制图桌",
        "description": "这张制图桌怎么看也不像是源石工业普及前的古文明该有的东西，难道有人捷足先登，在你们之前就已经造访了这片古迹？还是小心为上，万一这是某种陷阱呢？",
        "background": "pic_rogue_6_46",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_revive_enter": {
        "id": "scene_ro6_revive_enter",
        "title": "手术祭坛",
        "description": "丛林之中为什么会出现一条电缆？你顺着它摸索至此，眼前的景象不免令你感到诡异。之前在一次遇袭后与你走散的探险家此刻又出现在你面前，他被置放在一张桌台之上，身上连接着一些奇妙的电极。你试着唤醒他，但他没有任何反应。",
        "background": "pic_rogue_6_47",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_revive_1": {
        "id": "scene_ro6_revive_1",
        "title": "手术祭坛",
        "description": "那名青年挣扎了几下便清醒过来，休息了一会之后，开始向你说明原委。他重伤昏迷之前，被一只奇怪的黑色生物救下，并带到了这里治疗。再次醒来时，他发现自己已经躺在这张奇妙的桌台之上，黑色生物已经不再动弹，而他的意识也很快就变得模糊，直到再次苏醒见到你。他已经痊愈，并打算带那只黑色生物一起走。",
        "background": "pic_rogue_6_47",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_revive_2": {
        "id": "scene_ro6_revive_2",
        "title": "手术祭坛",
        "description": "你观察到青年的伤口正在愈合，或许这是某种医疗器械。眼下轻举妄动可能不是个好主意，立刻联络专业人员来帮助他才是最好的选择。",
        "background": "pic_rogue_6_47",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      }
    },
    "choices": {
      "choice_ro6_end4_1": {

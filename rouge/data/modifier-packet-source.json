  "facts": [
    "base_one sources merge old+new-1 with separate binary32 rounding before one modifier module",
    "independent normal healing/elemental sources multiply current FP packet once per module",
    "IsHeal filter is damageType HEAL; isDamage is nonNONE/nonHEAL and targetHP",
    "isCancelled is deltaCANCELLED or FP.Abs(value)<42950; absMIN uses MaxValue and is nonzero",
    "DamageScale early stop is isCancelled AND isDamage; ModifierScaleUp early stop is isCancelled",
    "selected templates have no one-minus/stack/cached-delta/custom-key branch",
    "numeric read explicit failure defaultsONE; object missing is exception; successzero/negative preserved",
    "set_value checks immutable mask65536 after multiplier computation and preserves old m_value if set"
  ],
  "limits": [
    "finite declared orders do not prove actual runtime ordering, coverage, MXCSR or current hotfix",
    "entry from explosion return requires independent created/unchanged qualifiers; not actual Modifier/HP proof",
    "selected source families only; recovery channels and elemental buildup are excluded"
  ]
}

  "originals": {
    "scenes": {
      "scene_ro6_final1_enter": {
        "id": "scene_ro6_final1_enter",
        "title": "险路尽头",
        "description": "你在密林中发现了一处黑色的池塘。平静的水面上浮着一层色彩绚丽的“油膜”，让你无法窥探池底的情形；粗糙尖利的石块围在池边，整个池塘宛如一张恶犬的大口。你不知道黑池通向哪里，但或许，摆脱猎犬追击的方法，就是跳入其他猎犬的口中。",
        "background": "pic_rogue_6_32",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_final1_3": {
        "id": "scene_ro6_final1_3",
        "title": "险路尽头",
        "description": "所幸你的同伴很相信你，哪怕遇险也不会离你远去。你深吸一口气，跳入黑池。",
        "background": "pic_rogue_6_32",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_final1_1": {
        "id": "scene_ro6_final1_1",
        "title": "险路尽头",
        "description": "在经历了一连串“超自然事件”之后，你明白了在这里表象与本质的关联微乎其微。勇气与经验成正比，现在，一池诡异的黑水无法拦住你的去路，你只是需要做些准备。",
        "background": "pic_rogue_6_32",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_final1_2": {
        "id": "scene_ro6_final1_2",
        "title": "险路尽头",
        "description": "冒进可能只会害你丧命。你离开黑池，回到了主路。",
        "background": "pic_rogue_6_32",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_final1_4": {
        "id": "scene_ro6_final1_4",
        "title": "险路尽头",
        "description": "这名学生气质的青年探险家感激地接过你递给他的干粮和水，稍息片刻后，他的脸色好多了。他向你解释道，自己的钱全都在黑市的拍卖会上花完了，如果不是你的帮助，恐怕他就只能乖乖跟着救援队离开了。现在他愿意与你分享他淘来的文物与线索，一同成为失落古代玻利瓦尔文明的首批发现者。",
        "background": "pic_rogue_6_32",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      }
    },

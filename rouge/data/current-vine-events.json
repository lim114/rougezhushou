  "originals": {
    "scenes": {
      "scene_ro6_normal1_enter": {
        "id": "scene_ro6_normal1_enter",
        "title": "沉寂之屋",
        "description": "你发现了一处废弃的哥伦比亚考察站，猜想屋内或许能找到一些还能用的物资。但附近隐隐传来猎犬的吠叫，让你感到不安。你观察了一阵，发现它们没有靠近站点。房屋破败不堪，疯长的植物几乎将整座站点吞没，你小心地走近，发现门上趴着的人形藤蔓死死堵住了入口。",
        "background": "pic_rogue_6_14",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_normal1_1": {
        "id": "scene_ro6_normal1_1",
        "title": "沉寂之屋",
        "description": "你用随身携带的刀具砍向人形藤蔓，刀子深深没入主茎又被卡住，仿佛砍中了某个硬物。你费了很大力气终于将门破开，从散落在地上的实验器材中找到了最为实用的那个。",
        "background": "pic_rogue_6_14",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_normal1_2": {
        "id": "scene_ro6_normal1_2",
        "title": "沉寂之屋",
        "description": "你觉得藤蔓似乎可以交流，想礼貌地请它离开。你看到它趴在门上扭动了一下，将一根侧枝伸向你的口袋，取走了一些源石锭。随后它的另一根侧枝钻入门缝，递出一样东西给你。",
        "background": "pic_rogue_6_14",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_normal1_3": {
        "id": "scene_ro6_normal1_3",
        "title": "沉寂之屋",
        "description": "猎犬就在附近，还是不要冒险了。",
        "background": "pic_rogue_6_14",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_normal3_enter": {
        "id": "scene_ro6_normal3_enter",
        "title": "呼吸的红苔",
        "description": "空气中弥漫着腥气，这里一片荒芜，唯独红色的苔藓引人注目，黑流自红苔中缓缓渗出，似乎要把所有来到此处的活物都溶解殆尽。你的到来让红苔更加活跃，黑流越积越多——而猎犬的吠声正自不远处传来。",
        "background": "pic_rogue_6_16",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_normal3_1": {
        "id": "scene_ro6_normal3_1",
        "title": "呼吸的红苔",
        "description": "猎犬的吠声渐止。你驱逐了此地的猎犬，红苔不再渗出黑流。周围变得安静且可怕，你仿佛正在见证某种可行性的诞生与成长。",
        "background": "pic_rogue_6_16",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_normal3_2": {
        "id": "scene_ro6_normal3_2",
        "title": "呼吸的红苔",
        "description": "你种下了种子，没等你埋好，红苔便包裹吞噬了它们。你不知道这些种子会长出什么，或许是一种仍在襁褓中的新可能。",
        "background": "pic_rogue_6_16",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_normal3_3": {
        "id": "scene_ro6_normal3_3",
        "title": "呼吸的红苔",
        "description": "这个地方有种说不出的诡异，还是先离开吧。",
        "background": "pic_rogue_6_16",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      }
    },

  "originals": {
    "scenes": {
      "scene_ro6_end2_enter": {
        "id": "scene_ro6_end2_enter",
        "title": "窥视箱中",
        "description": "“我一直在等你。”一只......猫？你并不确定她究竟是什么。“不明白也没有关系。我向正在观察我们之人言说，尽管我不知道你是否拥有生命和意识。我邀请你见证必将发生之事。”",
        "background": "pic_rogue_6_37",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end2_2": {
        "id": "scene_ro6_end2_2",
        "title": "窥视箱中",
        "description": "“你对它们的用途有一些猜测，对吗？”她对你露出了笑容，“不必紧张，它们并不会以你想象的方式运作。但即便我这么说，你仍会尝试阻止我，你也必须这么做。”",
        "background": "pic_rogue_6_37",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end2_1": {
        "id": "scene_ro6_end2_1",
        "title": "窥视箱中",
        "description": "“你不是来找我的？好吧。”她转过身去，没有回头再对你说什么，环境中只剩下机器持续运作的轻微噪音。为了避免再生事端，你决定离开这个可疑的地方。",
        "background": "pic_rogue_6_37",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end2_3": {
        "id": "scene_ro6_end2_3",
        "title": "窥视箱中",
        "description": "之前探险家发掘出的那枚黑色石板变得冰冷无比，它似乎正在迅速地抽走周边的热量。你忙不迭地将它丢在一边，避免被它冻伤。石板却转而开始从四周的设备中夺取能量，又向周围投射出若干扭曲的幻影，并且越来越多。她似乎吃了一惊，向你质问：“你究竟是什么人？是来夺回权限的吗？这是你第几次来到这里？”",
        "background": "pic_rogue_6_37",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      }
    },

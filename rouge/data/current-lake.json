  "originals": {
    "scenes": {
      "scene_ro6_bat5_enter": {
        "id": "scene_ro6_bat5_enter",
        "title": "湖中仙女",
        "description": "你在林中听到一阵温柔的吟唱声，声音的来源坐于浅湖中心的礁石上，手捧一束鲜艳的花，身下的湖水波光粼粼。她正招手邀请你过去。",
        "background": "pic_rogue_6_5",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_bat5_1": {
        "id": "scene_ro6_bat5_1",
        "title": "湖中仙女",
        "description": "“不少人都想找到湖中的秘宝，但总是缺乏诚意。”仙女用手将湖水拨弄出涟漪，露出腕上闪亮的手镯，“你愿意展现你的虔诚吗？”",
        "background": "pic_rogue_6_5",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_bat5_2": {
        "id": "scene_ro6_bat5_2",
        "title": "湖中仙女",
        "description": "这片树海中难以解释的事太多，连眼见都不一定为实。你没有再看她一眼，快步离开了。",
        "background": "pic_rogue_6_5",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_bat5_5": {
        "id": "scene_ro6_bat5_5",
        "title": "湖中仙女",
        "description": "她从湖中捞出一块磁石，看起来并不怎么值钱。“或许我们可以把它丢回湖里，找出更好的东西，你愿意展现你的虔诚吗？”",
        "background": "pic_rogue_6_5",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_bat5_6": {
        "id": "scene_ro6_bat5_6",
        "title": "湖中仙女",
        "description": "磁石被丢进湖里，仙女的手伸进湖水，这次她捞出一块手表，只是表盘已经破损，看起来也不怎么值钱。“或许我们可以把它丢回湖里，找出更好的东西，你愿意展现你的虔诚吗？”",
        "background": "pic_rogue_6_5",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_bat5_3": {
        "id": "scene_ro6_bat5_3",
        "title": "湖中仙女",
        "description": "你看清了美丽仙女的倒影，那是一个似蛇似蝎的怪物，湖水映出了她的真面目，而她无法再欺骗你了。",
        "background": "pic_rogue_6_5",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_bat5_4": {
        "id": "scene_ro6_bat5_4",
        "title": "湖中仙女",
        "description": "她的话语焉不详，而你不想继续纠缠下去。",
        "background": "pic_rogue_6_5",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_bat5_7": {
        "id": "scene_ro6_bat5_7",
        "title": "湖中仙女",
        "description": "手表被丢进湖里，仙女的手伸进湖水，这次她捞出了一条腐烂的胳膊，破损的手表正牢牢箍在肿大的手腕上。你低头看向仙女在湖中的倒影——一只似蛇又像蝎的生物。周围的景色变幻了，蓝色的火焰将你们围了起来，仙女扭曲的声音萦绕在耳畔：“ ¿吗诚虔的你现展意愿你”",
        "background": "pic_rogue_6_5",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_bat5_8": {
        "id": "scene_ro6_bat5_8",
        "title": "湖中仙女",
        "description": "你的虔诚让仙女十分感动，她将身下的湖水搅起一阵波涛，从水中捞出一件礼物送给你。",
        "background": "pic_rogue_6_5",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_bat5_9": {
        "id": "scene_ro6_bat5_9",
        "title": "湖中仙女",
        "description": "你拿着仙女从湖里打捞出的宝物，深感虔诚在此地的重要性。",
        "background": "pic_rogue_6_5",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      }

  "originals": {
    "scenes": {
      "scene_ro6_normal5_enter": {
        "id": "scene_ro6_normal5_enter",
        "title": "愈创之心",
        "description": "一片淡紫色的花瓣落在你身上。你抬头望见了一棵巨大的愈创木，树枝摇晃着，你突然觉得这里应该要有一个秋千。你走上前去，粗壮的树干上，一只人为刻印的小猫正在朝你微笑。你产生了一种奇怪的感觉，自己似乎不是第一次来到这里。",
        "background": "pic_rogue_6_18",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_normal5_1": {
        "id": "scene_ro6_normal5_1",
        "title": "愈创之心",
        "description": "你拥抱了愈创木，它也同样拥抱了你。你的意识仿佛坐上了那个不存在的秋千，反复荡到高处又落下，这种悬空的感觉让你在有些害怕的同时，又忍不住感到兴奋和欢欣。这里的一切都消失了，你的身边只剩下......一台相机？",
        "background": "pic_rogue_6_18",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_normal5_2": {
        "id": "scene_ro6_normal5_2",
        "title": "愈创之心",
        "description": "你决定用手上的材料在这里制作一个秋千。它的虚影仿佛从一开始就存在于你的脑海中，而你只需动手将虚影的形状填满。你完成之后，似乎听到了一阵无邪的笑声，然后一切都消失了，你的身边只剩下......一台相机？",
        "background": "pic_rogue_6_18",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_normal5_3": {
        "id": "scene_ro6_normal5_3",
        "title": "愈创之心",
        "description": "你比对着卡片上印的像素小猫和树干上的刻印图案，似乎理解了什么。像素小猫跳出了卡片，和树干上的图案融为一体。你仿佛看见一名少女在秋千上欢笑，但随即这里的一切都消失了，你的身边只剩下......一台相机？",
        "background": "pic_rogue_6_18",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_normal5_4": {
        "id": "scene_ro6_normal5_4",
        "title": "愈创之心",
        "description": "你担心此处仍有被猎犬围攻的隐患，拿出笼控器想要控制未知的危险。仪器示数归为零，你的意识也渐渐消散，你看到刻印小猫在微笑，你仿佛置身于愈创木内部，浑身充满了力量——你能走得更远，你坚信着。",
        "background": "pic_rogue_6_18",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_normal5_5": {
        "id": "scene_ro6_normal5_5",
        "title": "愈创之心",
        "description": "愈创木的馥郁烟熏香气夹杂着花香，让你感到前所未有的平静。你摸了摸树干上刻印的小猫，它笑眯眯的眼睛似乎在鼓励你再往前探索一点，或许这就是它存在于此处的意义。",
        "background": "pic_rogue_6_18",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      }
    },

  "originals": {
    "scenes": {
      "scene_ro6_scout_enter": {
        "id": "scene_ro6_scout_enter",
        "title": "未涉足之树",
        "description": "你从未见过生长到这个高度的树，一眼望不到树顶。它是何时开始生长于此处？如果抵达它的树冠，是否能离开这片树海？你围着树转了一圈，发现树皮表面有着奇特的人工纹路，暖光从树皮的缝隙中渗出来，勾勒出一扇门的形状。这里也许有出路，但仍需谨慎。",
        "background": "pic_rogue_6_22",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_scout_2": {
        "id": "scene_ro6_scout_2",
        "title": "未涉足之树",
        "description": "树干上出现了一个像门一样的缺口，看上去像是一座......电梯？你的同伴出发了，你好奇地在树下等待，希望得知电梯会到达哪里。",
        "background": "pic_rogue_6_22",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_scout_3": {
        "id": "scene_ro6_scout_3",
        "title": "未涉足之树",
        "description": "树干上的纹理看上去像是某种奇妙的电路图，它们似乎通向大树的核心处。你的同伴出发了，它沿着那些奇妙的纹路追踪，说不定能够找到这个电梯装置的设计者，弄明白那家伙的意图。",
        "background": "pic_rogue_6_22",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_scout_1": {
        "id": "scene_ro6_scout_1",
        "title": "未涉足之树",
        "description": "你决定先不去探察，至少这里温暖又安全，在休息一会儿后便离开了。",
        "background": "pic_rogue_6_22",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      }
    },

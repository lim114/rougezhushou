  "originals": {
    "scenes": {
      "scene_ro6_bomb1_enter": {
        "id": "scene_ro6_bomb1_enter",
        "title": "线人",
        "description": "绕过树丛，一座营地出现在你面前，令人匪夷所思的是，它似乎正在将自己折叠和打包起来，并未借助任何外力。就在你看得入迷时，一只目光锐利的鸟悄然来到你身旁，用一台你不曾见过的小型手持仪器抵着你的脖颈。“能否告诉我，你为谁服务？”",
        "background": "pic_rogue_6_35",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_bomb1_1": {
        "id": "scene_ro6_bomb1_1",
        "title": "线人",
        "description": "“看来确实如此。”它手中的仪器亮起了绿色的灯光，“抱歉，我用自制的测谎装置试探了你，朋友。我和你一样在追查不明的电信号来源，但我携带的补给已经不足，只能先撤退了。我会把掌握的线索全都交给你，希望你可以替我完成任务。”",
        "background": "pic_rogue_6_35",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_bomb1_2": {
        "id": "scene_ro6_bomb1_2",
        "title": "线人",
        "description": "“能走到这里很不容易。”它似乎露出了一丝不易察觉的笑容，“再往前走，你或许会面对难以想象的危险，但对探险家来说，这也可能是难得的机遇。我这里有一些没法打包带走的物资，就留给你吧。”",
        "background": "pic_rogue_6_35",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_bomb1_3": {
        "id": "scene_ro6_bomb1_3",
        "title": "线人",
        "description": "“你不应该来这里。”它严肃地看着你，“你并不理解他们究竟将你置于怎样的险境。早些回头吧，我不会为难你。”",
        "background": "pic_rogue_6_35",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end1_enter": {
        "id": "scene_ro6_end1_enter",
        "title": "好奇心与死",
        "description": "“我一直在等你。”一只猫？你并不确定它究竟是什么。“但你不太走运。在黑流树海之中，距离和方向并没有实质意义。”你伸出手去触碰，却发现周围的一切事物都变成了虚幻的立体投影。",
        "background": "pic_rogue_6_36",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end1_1": {
        "id": "scene_ro6_end1_1",
        "title": "好奇心与死",
        "description": "你用手头的物资与这里的电源临时搭建起一个信号发射器，新的坐标在你的终端上浮现。与此同时，这处据点的机器和那只猫的投影都消失了，像是从不曾存在过一般。",
        "background": "pic_rogue_6_36",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end1_2": {
        "id": "scene_ro6_end1_2",
        "title": "好奇心与死",
        "description": "是那只猫的源石技艺吗？你想要弄个明白，但在你走上前快要抓住它的瞬间，周围的一切都骤然消失了，只剩下一个闪闪发光的物件掉在你的脚边。",
        "background": "pic_rogue_6_36",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      }
    },

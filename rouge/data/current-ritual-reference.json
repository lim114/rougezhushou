    "scenes": {
      "scene_ro6_end3_enter": {
        "id": "scene_ro6_end3_enter",
        "title": "调谐仪式",
        "description": "是谁在巨树的内部制造了这个斗兽场般的空间？远处的三头怪物咆哮着，挣扎着，尝试离开这里。一旁墙上的壁画吸引了你的注意，你似乎在哪里见过这些场景。上面的凹槽是某种机关装置吗？",
        "background": "pic_rogue_6_39",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end3_1": {
        "id": "scene_ro6_end3_1",
        "title": "调谐仪式",
        "description": "邪恶的鸟头怪物掀起黑风吹向村落，削平人们的住所。若能携手铸造出坚固的神明救世巨像，借其双臂护佑此地，是否能够避免那黑风再制造血泪？",
        "background": "pic_rogue_6_39",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end3_2": {
        "id": "scene_ro6_end3_2",
        "title": "调谐仪式",
        "description": "不需要依靠那些来路不明的可疑装置，不必屈服于这种像是被谁安排好的宿命。既然能来到这里，就有信心也有力量去对抗任何灾难。",
        "background": "pic_rogue_6_39",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end3_3": {
        "id": "scene_ro6_end3_3",
        "title": "调谐仪式",
        "description": "残忍的羊头怪物点燃黑焰焚尽诗歌，烧毁精神的旗帜。若能回忆起诞生于劳作中的轻声哼唱，团结一心永不言败，是否能够找回被黑焰吞没的曙光？",
        "background": "pic_rogue_6_39",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end3_4": {
        "id": "scene_ro6_end3_4",
        "title": "调谐仪式",
        "description": "悲愤的狗头怪物啜饮黑流立誓复仇，献祭自己的灵魂。若能决心停止与同伴之间的利益纷争，不以真假区隔同胞，是否能够停止在黑流中继续沉沦？",
        "background": "pic_rogue_6_39",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_end3_5": {
        "id": "scene_ro6_end3_5",
        "title": "调谐仪式",
        "description": "你对这个空间与这幅壁画都感到有些毛骨悚然，究竟是谁出于什么目的，又是如何制造了这一切？或许只有一个方法能为你指明答案——",
        "background": "pic_rogue_6_39",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_chimera2_enter": {
        "id": "scene_ro6_chimera2_enter",
        "title": "泪之聚落",
        "description": "你来到了一处似乎曾是聚落的地方，这里满地狼藉，惨不忍睹。一只族长模样的鸟向你走来，用树枝在地上涂涂写写，向你比画。看起来是有一只有翼怪物曾袭击此地，毁掉了聚落，杀死了它们的神明和族人，它应该是想向你请求帮助。",
        "background": "pic_rogue_6_38",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_chimera2_1": {
        "id": "scene_ro6_chimera2_1",
        "title": "泪之聚落",
        "description": "族长伏地向你表示感谢。它希望你能够再答应一个请求：将它们的神明带去黑流深处。它们相信那是神明的来处，也当是神明的归处。",
        "background": "pic_rogue_6_38",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_chimera2_2": {
        "id": "scene_ro6_chimera2_2",
        "title": "泪之聚落",
        "description": "猎犬还在追逐，你不能停留在此处提供帮助，这或许会给它们带来灾难，并且你也无法负担如此巨额的物资开支。它似乎理解了你的意思，默默地离去，继续为它们死去的神明和同胞哀悼。",
        "background": "pic_rogue_6_38",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      }
    },

        },
        {
          "branch_id": "community_group_023:scene:1:choice:0:sub:2",
          "label": "松鼠",
          "target_scene_key": "community_group_023:scene:5",
          "target_scene_number": 6,
          "target_scene_description": "“我想去看看外面的大地。”一只松鼠跳上你的肩膀，“比树上能看到的更远，比河流所至更远。我们不应停滞在此。”它的同伴一只接着一只跳上你的肩膀，你肩负起这些松鼠远大的志向，决心向着更远的地方走去。",
          "future_buttons": [
            {
              "choice_key": "community_group_023:scene:5:choice:0",

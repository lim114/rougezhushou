            }
          ],
          "actual_transition": null,
          "actual_reward": null
        },
        {
          "branch_id": "community_group_023:scene:1:choice:0:sub:1",
          "label": "捕梦网",
          "target_scene_key": "community_group_023:scene:4",
          "target_scene_number": 5,
          "target_scene_description": "一张捕梦网垂了下来，羽毛抚过你的脸，你听到一个女性的声音响起，为你哼唱起一首童谣，你看不见她的面容，却感到安心。\n“睡吧。”她说，“愿你的疲惫散去，愿你的心灵得到净化。”",
          "future_buttons": [
            {
              "choice_key": "community_group_023:scene:4:choice:0",
              "title": "闭眼感受",
              "description": "获得15护盾",

      "branches": [
        {
          "branch_id": "community_group_023:scene:1:choice:0:sub:0",
          "label": "小狗",
          "target_scene_key": "community_group_023:scene:2",
          "target_scene_number": 3,
          "target_scene_description": "你摸了摸熟睡小狗的头，它似乎做了一个美梦。梦里它的同伴们一直在等它，它晃着尾巴回到同伴身边后，便迫不及待地讲起了自己的见闻——会吃活物的树、金色的溪流、静止的蝴蝶……它的同伴们安静地听着，随后纷纷起身用舌头舔舐它的头，它所感受到的温柔，与你抚摸它时一样。",
          "future_buttons": [
            {
              "choice_key": "community_group_023:scene:2:choice:0",
              "title": "抚摸小狗的脑袋",
              "description": "获得20希望",
              "quantity_reference": 20,
              "resource": "hope",
              "category_text": null,
              "item_pool": null,
              "game_choice_ids": [

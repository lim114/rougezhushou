            {
              "line": 7,
              "text": "def build(source):"
            },
            {
              "line": 8,
              "text": "    data=json.loads(source.read_text(encoding='utf-8'))"
            },
            {
              "line": 9,
              "text": "    excluded=[]"
            },
            {
              "line": 10,
              "text": "    for profile in data['operators'].values():"
            },
            {
              "line": 11,
              "text": "        for record in profile['records']:"
            },
            {
              "line": 12,
              "text": "            if 'Deploy' in record['animation'] and record['selectable_as_conventional_reference']:"
            },
            {
              "line": 13,
              "text": "                record['selectable_as_conventional_reference']=False"
            },
            {
              "line": 14,
              "text": "                record['unverified_reasons'].append('deployment animation requires separate lifecycle binding')"
            },
            {
              "line": 15,
              "text": "                record.pop('preview',None);excluded.append(record['id'])"
            },
            {
              "line": 16,
              "text": "    records=[r for p in data['operators'].values() for r in p['records']]"
            },
            {
              "line": 17,
              "text": "    data['counts']['selectable_references']=sum(r['selectable_as_conventional_reference'] for r in records)"
            },
            {
              "line": 18,
              "text": "    data['counts']['unverified_or_transition_references']=sum(not r['selectable_as_conventional_reference'] for r in records)"
            },
            {
              "line": 19,
              "text": "    data['selection_derivation']={'source_file':str(source.relative_to(ROOT)),"
            },
            {
              "line": 20,
              "text": "        'source_sha256':hashlib.sha256(source.read_bytes()).hexdigest(),"
            },
            {
              "line": 21,
              "text": "        'excluded_deployment_motions':excluded,'runtime_binding_inferred':False}"
            },
            {
              "line": 22,
              "text": "    return data"
            }
          ]
        }
      ]

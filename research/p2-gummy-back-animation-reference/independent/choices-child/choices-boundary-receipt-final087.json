            {
              "line": 13,
              "text": "def choices(operator,skill=None,*,normal=False):"
            },
            {
              "line": 14,
              "text": "    records=references()['operators'].get(operator,{}).get('records',[])"
            },
            {
              "line": 15,
              "text": "    selected=[]"
            },
            {
              "line": 16,
              "text": "    for record in records:"
            },
            {
              "line": 17,
              "text": "        if not record['selectable_as_conventional_reference']:continue"
            },
            {
              "line": 18,
              "text": "        name=record['animation']"
            },
            {
              "line": 19,
              "text": "        number=re.match(r'^Skill_?(\\d+)(?:_|$)',name)"
            },
            {
              "line": 20,
              "text": "        ordinary=name.startswith('Attack')"
            },
            {
              "line": 21,
              "text": "        if (normal and ordinary) or (not normal and (ordinary or number and int(number[1])==skill)):"
            },
            {
              "line": 22,
              "text": "            selected.append(record)"
            },
            {
              "line": 23,
              "text": "    return selected"
            }
          ]
        },
        {
          "start": 26,
          "end": 39,
          "lines": [
            {
              "line": 26,
              "text": "def label(record):"
            },
            {
              "line": 27,
              "text": "    face={'Front':'正面','Back':'背面'}[record['orientation']]"
            },
            {
              "line": 28,
              "text": "    motion=record['animation']"
            },
            {
              "line": 29,
              "text": "    number=re.match(r'^Skill_?(\\d+)(?:_|$)',motion)"
            },
            {
              "line": 30,
              "text": "    if motion.startswith('Attack'):"
            },
            {
              "line": 31,
              "text": "        suffix=motion.removeprefix('Attack').strip('_')"
            },
            {
              "line": 32,
              "text": "        suffix={'Down':'向下动作'}.get(suffix,suffix)"
            },
            {
              "line": 33,
              "text": "        action='普通攻击'+(' '+suffix if suffix else '')"
            },
            {
              "line": 34,
              "text": "    elif number:"
            },
            {
              "line": 35,
              "text": "        suffix=motion[number.end():]"
            },
            {
              "line": 36,
              "text": "        action=f'技能{number[1]}动作'+({'Attack':' · 攻击','Combat':' · 攻击'}.get(suffix,' · 动作变体' if suffix else ''))"
            },
            {
              "line": 37,
              "text": "    else:action='攻击动作参考'"
            },
            {
              "line": 38,
              "text": "    preview=record['preview']"
            },
            {
              "line": 39,
              "text": "    return f\"{face} · {action} · 出手{preview['windup_frames']}帧 / 动画{preview['animation_frames']}帧\""
            }
          ]
        },
        {
          "start": 42,
          "end": 51,
          "lines": [
            {
              "line": 42,
              "text": "def descriptor(operator,skill,options,*,normal=False):"
            },
            {
              "line": 43,
              "text": "    field='normal_animation_reference' if normal else 'animation_reference'"
            },
            {
              "line": 44,
              "text": "    identity=options.get(field)"
            },
            {
              "line": 45,
              "text": "    if identity is None:return None"
            },
            {
              "line": 46,
              "text": "    record=next((r for r in choices(operator,skill,normal=normal) if r['id']==identity),None)"
            },
            {
              "line": 47,
              "text": "    if record is None:raise ValueError('原版动画参考与当前干员/技能不符，或该动作不适合常规逐击参考。')"
            },
            {
              "line": 48,
              "text": "    return {**record['preview'],'animation':record['animation'],'source':record['source']['url'],"
            },
            {
              "line": 49,
              "text": "        'reference_id':identity,'reference_label':label(record),"
            },
            {
              "line": 50,
              "text": "        'original_orientation':record['orientation'],'skin':'original',"
            },
            {
              "line": 51,
              "text": "        'runtime_binding_verified':False,'source_sha256':record['source']['sha256']}"
            }
          ]
        }
      ]
    },

    "choiceScenes": {
      "scene_ro6_surprise_enter": {
        "id": "scene_ro6_surprise_enter",
        "title": "安眠一隅",
        "description": "不知道第几次迷失在树海中之后，你看见一只泛着橙黄色光芒的小狗从灌木中钻了出来。它晃着尾巴在你面前一蹦一跳，你跟上它的脚步，直到它消失于一棵树后。你绕着树走了一圈，依然不见它的身影，抬头发现树干上有一只像素风格的小猫，手指触碰到猫的瞬间，你感受到来自另一空间的剧烈拉扯——",
        "background": "pic_rogue_6_34",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_surprise_1": {
        "id": "scene_ro6_surprise_1",
        "title": "安眠一隅",
        "description": "一张被树木包围的柔软病床出现在眼前，床边的仪器屏幕如呼吸般闪烁着。阳光像细密的纺线自树冠的间隙中散落，温暖的风，甜美的果香，一切都是如此舒畅。轻快的吠声吸引了你，引领你来到此地的小狗兴奋地摇着尾巴，跳上床酣睡起来。",
        "background": "pic_rogue_6_34",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_surprise_2": {
        "id": "scene_ro6_surprise_2",
        "title": "安眠一隅",
        "description": "你摸了摸熟睡小狗的头，它似乎做了一个美梦。梦里它的同伴们一直在等它，它晃着尾巴回到同伴身边后，便迫不及待地讲起了自己的见闻——会吃活物的树、金色的溪流、静止的蝴蝶......它的同伴们安静地听着，随后纷纷起身用舌头舔舐它的头，它所感受到的温柔，与你抚摸它时一样。",
        "background": "pic_rogue_6_34",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_surprise_7": {
        "id": "scene_ro6_surprise_7",
        "title": "安眠一隅",
        "description": "你围观了豹子们的竞速比赛，它们的终点没有猎物，它们只有对于狂奔的渴望。豹子们跑出了这片树海，甩开了身后的河流，甩开了被猎枪追逐的命运，一直没有回头。",
        "background": "pic_rogue_6_34",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_surprise_3": {
        "id": "scene_ro6_surprise_3",
        "title": "安眠一隅",
        "description": "一张捕梦网垂了下来，羽毛抚过你的脸，你听到一个女性的声音响起，为你哼唱起一首童谣，你看不见她的面容，却感到安心。\r\n“睡吧。”她说，“愿你的疲惫散去，愿你的心灵得到净化。”",
        "background": "pic_rogue_6_34",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_surprise_4": {
        "id": "scene_ro6_surprise_4",
        "title": "安眠一隅",
        "description": "“我想去看看外面的大地。”一只松鼠跳上你的肩膀，“比树上能看到的更远，比河流所至更远。我们不应停滞在此。”它的同伴一只接着一只跳上你的肩膀，你肩负起这些松鼠远大的志向，决心向着更远的地方走去。",
        "background": "pic_rogue_6_34",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_surprise_5": {
        "id": "scene_ro6_surprise_5",
        "title": "安眠一隅",
        "description": "这里似乎曾是谁建立的疗愈室，但如今已经无人问津，或许有什么其他东西仍能使用。你在床周围的树干上又发现了同样的小猫图案——",
        "background": "pic_rogue_6_34",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_surprise_6": {
        "id": "scene_ro6_surprise_6",
        "title": "安眠一隅",
        "description": "你来到一片果园，一颗番石榴落在你的脚边，你的同伴嘴里叼着另一颗，示意你快些捡起来吃掉。“我妈妈说，今年的番石榴很好吃。”你的同伴说，“你要不要一起来帮忙？果子就要摘不完了，全都是我们自己的，你想吃多少就吃多少。”",
        "background": "pic_rogue_6_34",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_surprise_8": {
        "id": "scene_ro6_surprise_8",
        "title": "安眠一隅",
        "description": "前所未有的温暖将你包裹住，但你该继续前进了。你依依不舍地看了一眼床上的小狗，离开了这个奇异的地方。",
        "background": "pic_rogue_6_34",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_surprise_9": {
        "id": "scene_ro6_surprise_9",
        "title": "安眠一隅",
        "description": "这里似乎曾是谁建立的疗愈室，但如今已经无人问津，或许有什么其他东西仍能使用。你在床周围的树干上又发现了同样的小猫图案——",
        "background": "pic_rogue_6_34",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_surprise_10": {
        "id": "scene_ro6_surprise_10",
        "title": "安眠一隅",
        "description": "你发现床上多了一组动物泥偶，它们正费力地抬起小狗的耳朵，和它说着悄悄话。你凑了过去，泥偶们立刻噤声。“嘘。”其中一只说，“训练很辛苦，它需要好好休息。”“它正在美梦中，梦里我们也会在。”另一只说，“这是我们相见的唯一方式。”",
        "background": "pic_rogue_6_34",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      },
      "scene_ro6_surprise_11": {
        "id": "scene_ro6_surprise_11",
        "title": "安眠一隅",
        "description": "这里似乎曾是谁建立的疗愈室，但如今已经无人问津，或许有什么其他东西仍能使用。你在床周围的树干上又发现了同样的小猫图案——",
        "background": "pic_rogue_6_34",
        "titleIcon": null,
        "subTypeId": 0,
        "useHiddenMusic": false
      }

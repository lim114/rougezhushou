  "differences": [
    {
      "id": "duration20_vs10",
      "fact": "卡德霍同页摘要20秒、完整基础Blink卡10秒；普通原配置duration=10.0，追猎覆写duration=20.0。不能因数值相同就断定摘要针对追猎版。"
    },
    {
      "id": "summon_vs_configuration",
      "fact": "摘要称召唤；完整能力/感受痛楚卡明确猎犬和化身由关卡配置生成。原主队列/分支有独立SPAWN声明，不代表真实回调已恢复。"
    },
    {
      "id": "uncertain_release",
      "fact": "完整能力的释放2次(存疑)保持原样，不以当前level反推唯一执行。"
    },
    {
      "id": "avatar_scope",
      "fact": "原图鉴仅剩余痛楚化身，社区修正及完整能力卡为全场敌方单位；保留版本/提示依据，不冒当前服务器观测。"
    },
    {
      "id": "variant",
      "fact": "b4_b有独立skills覆写和两条useDb=false自定义化身；definitions={}不等于原配置空，不扩普通版入口。"
    }
  ],

+def checked_current_gui_observation(case,caller,result,base):
+    """Positive fixed frame-only current clock and independent full-cast checks."""
+    identity=case['id'];assert identity in GUI_FRAME_OBSERVATIONS
+    op,scope,ammo,interval,starts,pellets,spacing,current_end,resume,full_end=GUI_FRAME_OBSERVATIONS[identity]
+    assert case['operator']==caller['operator']==op and case['mode']==caller['timing_mode']=='frames'
+    assert caller['skill']==case['skill']==(1 if op=='mechanist' else 2)
+    assert (caller['elite'],caller['level'],caller['skill_rank'],caller['trust'],caller['potential'])==(2,1,7,0,1)
+    assert caller['module_id'] is None and caller['module_level']==0
+    for key in ('relic_ids','char_buff_ids','char_buff_absent_ids','char_buff_pending_ids'):
+        same(caller.get(key,[]),[],'fixed GUI no selected relic/buff '+key)
+    for key in ('run_config','relic_context'):
+        same(caller.get(key,{}),{},'fixed GUI empty '+key)
+    assert not {'initial_sp_bonus','sp_recovery_bonus','_relic_rules','_relic_final_attack_factor'} & set(caller)
+    same(caller['timing'],case['timing'],'fixed whole GUI declaration without hidden clock inputs')
+    assert caller['timing']['windup_frames']==caller['timing']['recovery_frames']==0
+    assert type(caller['window_seconds']) in (int,float) and math.isfinite(caller['window_seconds'])
+    assert caller['window_seconds']==case['seconds']
+    horizon=math.ceil(caller['window_seconds']*30-1e-9)
+    same(horizon,60 if case['shape']=='short_control' else 300,'fixed GUI observation frame horizon')
+    same(result['ammo_rounds'],ammo,'fixed GUI actual ammunition limit')
+    assert result['timing']['mode']=='frames' and result['timing']['fps']==30
+    streams=result['timing']['streams'];assert type(streams) is list and len(streams)==1
+    stream=streams[0]
+    assert stream['unit']==op and stream['target_scope']==scope
+    assert stream['known_animation'] is True and stream['temporary_attack_speed'] is False
+    same(stream['windup_frames'],0,'fixed GUI manual windup')
+    same(stream['recovery_frames'],0,'fixed GUI manual recovery')
+    same(stream['start_frames'],list(starts),'whole fixed GUI actual starts')
+    same(stream['release_frames'],list(starts),'whole fixed GUI actual releases')
+    same(stream['interval_frames'],interval,'fixed GUI actual cadence')
+    same(stream['interval_seconds'],interval/30,'fixed GUI actual cadence seconds')
+    same(stream['interval_frames_by_attack'],[interval]*len(starts),'whole GUI per-attack cadence')
+    current_complete=len(stream['release_frames'])>=result['ammo_rounds']
+    if current_complete:
+        derived_end=stream['release_frames'][-1]+(pellets-1)*spacing+1
+        same(derived_end,current_end,'GUI full ammunition current placement end')
+        same(result['execution_seconds'],derived_end/30,'GUI current placed execution seconds')
+        effective_end=math.ceil(result['execution_seconds']*30-1e-9)
+        same(effective_end,derived_end,'GUI current execution end frame roundtrip')
+    else:
+        assert current_end is None and result['execution_seconds'] is None
+        effective_end=horizon
+    derived_resume=max(0,stream['start_frames'][-1]+interval-effective_end) if starts else 0
+    same(derived_resume,resume,'independent GUI current resume formula')
+    same(stream['resume_frame'],derived_resume,'actual GUI current resume value')
+    skill=result['estimate']['skill']
+    full_known=case['shape'] not in ('limited_windows','positive_lifetime','interrupted_tail','empty_control')
+    if full_known:
+        planned_starts=[i*interval for i in range(ammo)]
+        planned_end=planned_starts[-1]+(pellets-1)*spacing+1
+        same(planned_end,full_end,'independent GUI full ammunition placement end')
+        same(skill['duration_seconds'],planned_end/30,'GUI full cast known independently of current completion')
+        full_damage=base*1.1*ammo*pellets if op=='mechanist' else 0 if scope=='friendly' else base*2.25*3.5*ammo
+        full_healing=0 if op=='mechanist' else base*2.25*1.7*case['healing_targets']*ammo
+        near(skill['total_damage'],full_damage,'independent GUI complete cast damage')
+        near(skill['total_healing'],full_healing,'independent GUI complete cast potential healing')
+    else:
+        assert full_end is None and skill['duration_seconds'] is None
+        for key in ('cycle_seconds','cycle_damage','cycle_healing','cycle_dps','cycle_hps'):
+            assert skill[key] is None,(identity,key,skill[key])
+        if case['shape']=='empty_control':
+            near(skill['total_damage'],0,'GUI empty full zero damage')
+            near(skill['total_healing'],0,'GUI empty full zero healing')
+        else:
+            assert skill['total_damage'] is None
+            if op=='kaltsit':assert skill['total_healing'] is None
+            else:near(skill['total_healing'],0,'GUI partial mechanical full zero healing')
+    return {'case':identity,'current_release_count':len(starts),'ammo_rounds':ammo,

              "line": 9,
              "text": "SUPPORTED=BASE_KINDS|{'redeploy_delta','initial_sp','end_sp','caster_end_sp','sp_cost_factor','healing_factor',"
            },
            {
              "line": 10,
              "text": "    'enemy_def_delta','enemy_hp_factor','enemy_spawn_hp_branch','enemy_weight_delta','attack_sp','received_sp','event_sp','regeneration','regeneration_factor',"
            }
          ]
        },
        {
          "start": 110,
          "end": 120,

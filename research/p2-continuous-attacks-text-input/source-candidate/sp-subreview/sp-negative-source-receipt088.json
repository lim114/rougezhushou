        {
          "start": 326,
          "end": 334,
          "lines": [
            {
              "line": 326,
              "text": "def recharge_requirement(scenario,cost):"
            },
            {
              "line": 327,
              "text": "    return max(0,cost-sum(r['value'] for r in scenario.get('_relic_rules',[]) if r['kind'] in ('end_sp','caster_end_sp')))"
            },
            {
              "line": 328,
              "text": ""
            },
            {
              "line": 329,
              "text": "def effective_skill(skill,scenario):"
            },
            {
              "line": 330,
              "text": "    rules=scenario.get('_relic_rules',[])"
            },
            {
              "line": 331,
              "text": "    factors=[r['value'] for r in rules if r['kind']=='sp_cost_factor']"
            },
            {
              "line": 332,
              "text": "    factor=factors[0] if len(factors)==1 else 1"
            },
            {
              "line": 333,
              "text": "    return {**skill,'sp_cost':skill['sp_cost']*factor,"
            },
            {
              "line": 334,
              "text": "        'initial_sp':skill['initial_sp']+sum(r['value'] for r in rules if r['kind']=='initial_sp')}"
            }
          ]
        }

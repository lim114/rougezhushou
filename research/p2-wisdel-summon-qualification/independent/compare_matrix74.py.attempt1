from pathlib import Path
import sys,json,gzip,hashlib,copy,collections
sys.dont_write_bytecode=True
OUT=Path(__file__).parent;DRAFT=OUT/'draft74-independent'
sys.path.insert(0,str(DRAFT))
from rouge.reporting import format_report,readable_description
from rouge.estimate import format_estimate
S=lambda x:json.dumps(x,ensure_ascii=False,sort_keys=True,separators=(',',':'),allow_nan=False)
KEY='wisdel_summon_qualification_reference';SID='wisdel_summon_qualification'
rows=[]
for side in ['baseline','draft']:
 packed=(OUT/f'{side}74-whole-outcomes.json.gz').read_bytes();raw=gzip.decompress(packed);r=json.loads((OUT/f'{side}74-matrix-receipt.json').read_text())
 assert hashlib.sha256(packed).hexdigest()==r['compression']['gzip_sha256'] and hashlib.sha256(raw).hexdigest()==r['compression']['raw_sha256']
 rows.append(json.loads(raw))
a,b=rows;unexpected=[];qualification=[];reporterrors=[];math_drift=[];oldreport_drift=[];newids=[]
metadata_count=0;error_count=0;full_changed=0
for x,y in zip(a,b):
 if S({k:v for k,v in x.items() if k!='outcome'})!=S({k:v for k,v in y.items() if k!='outcome'}):unexpected.append(x['key'])
 full_changed+=S(x['outcome'])!=S(y['outcome'])
 if not x['outcome']['accepted']:
  error_count+=1
  if S(x['outcome'])!=S(y['outcome']):unexpected.append(x['key'])
  continue
 z=copy.deepcopy(y['outcome']);r=z['result'];metadata=r.pop(KEY,None)
 sections=[s for s in r['report']['sections'] if s['id']==SID]
 r['report']['sections']=[s for s in r['report']['sections'] if s['id']!=SID]
 if S(x['outcome']['result'])!=S(r):math_drift.append(x['key'])
 # Render the stripped existing report with the patched formatter; old content is byte-for-byte preserved.
 for field,rendered in [('formatted_report',format_report(r)),('technical_report',format_report(r,technical=True)),('formatted_estimate',format_estimate(r))]:
  if rendered!=x['outcome'][field]:oldreport_drift.append({'key':x['key'],'field':field})
 if x['input']['operator']!='char_1035_wisdel':
  if metadata is not None or sections or S(x['outcome'])!=S(y['outcome']):unexpected.append(x['key'])
  continue
 metadata_count+=1
 if metadata is None or len(sections)!=1:reporterrors.append(x['key']);continue
 elite=x['input'].get('elite',2);skill=x['input']['skill'];rank=x['input'].get('skill_rank',10)
 if metadata['talent_route']['cultivation_qualified']!=(elite==2) or metadata['skill_route']['cultivation_qualified']!=(elite==2):qualification.append(x['key'])
 if metadata['skill_route']['currently_selected']!=(skill==3):qualification.append(x['key'])
 level_source=metadata['skill_route']['selected_level_source']
 if skill==3:
  if level_source is None or level_source['rank']!=rank or level_source['values']['max_cnt']!=(1.0 if rank<=6 else 2.0):qualification.append(x['key'])
 else:
  if level_source is not None:qualification.append(x['key'])
 if metadata['actual_source_provenance'] is not None or any(metadata[k] for k in ['actual_presence_verified','actual_cast_clock_verified','covers_all_routes','declared_counts_reinterpreted']):qualification.append(x['key'])
 expected_status='已达原表培养门槛' if elite==2 else '未达原表培养门槛'
 metrics={m['id']:m['value'] for m in sections[0]['metrics']}
 if metrics.get('talent_qualification')!=expected_status or metrics.get('s3_qualification')!=expected_status or metrics.get('s3_selected')!=('是' if skill==3 else '否'):reporterrors.append(x['key'])
 notes=sections[0]['notes']
 expected_description=(readable_description(level_source['description'],level_source['values']) if level_source else '…'.join(metadata['skill_route']['original_common_fragments']))
 if not any(n.endswith(expected_description) for n in notes):reporterrors.append(x['key'])
 newids.append(x['key'])
result={'status':'PASS' if not any([unexpected,qualification,reporterrors,math_drift,oldreport_drift]) else 'FAIL','baseline_head':'552a6f3ab8b16cce49a9cf0de1e247c3ff49e3a9','patch_sha256':'f575adbd072df964ef65a61c0b66d7d9e6ae52250a3cf36601a36c9e07c805dc','scenarios':len(a),'actual_public_calls':len(a)+len(b),'accepted_eachside':len(a)-error_count,'errors_eachside':error_count,'full_outcome_changed':full_changed,'full_outcome_unchanged':len(a)-full_changed,'metadata_and_section_pairs_checked':metadata_count,'all_old_result_fields_strict_json_unchanged_after_only_metadata_and_section_removal':not math_drift,'all_old_three_report_strings_unchanged_when_only_new_section_removed':not oldreport_drift,'all_error_contracts_unchanged':not unexpected,'qualification_failures':qualification,'report_failures':reporterrors,'math_or_old_data_drift':math_drift,'old_report_drift':oldreport_drift,'unexpected_changes':unexpected,'new_section_keys':newids,'comparison':'Strict typed JSON including reports; only explicit new metadata top-level field and explicit report section id removed. No numeric/clock/conditional fields stripped.'}
(OUT/'final74-comparison-receipt.json').write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\n')
print(json.dumps({k:v for k,v in result.items() if k!='new_section_keys'},ensure_ascii=False))
assert result['status']=='PASS'

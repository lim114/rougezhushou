{
  "event_documents": [
    {
      "revision": "427904",
      "group_identity": "未涉足之树 / 先行一步",
      "scenes": [
        {
          "scene_number_zero_based": 0,
          "attributes": {
            "class": "scene",
            "data-etype": "先行一步",
            "id": "先行一步",
            "data-nav": "开始",
            "data-image": "Avg_pic_rogue_6_22",
            "data-name": "未涉足之树",
            "data-ename": "",
            "data-index": "130",
            "data-prtsinfo": ""
          },
          "description": "你从未见过生长到这个高度的树，一眼望不到树顶。它是何时开始生长于此处？如果抵达它的树冠，是否能离开这片树海？你围着树转了一圈，发现树皮表面有着奇特的人工纹路，暖光从树皮的缝隙中渗出来，勾勒出一扇门的形状。这里也许有出路，但仍需谨慎。",
          "choices": [
            {
              "attributes": {
                "class": "choose",
                "data-type": "simple",
                "data-title": "尝试探索树的内部",
                "data-icon": "adventure",
                "data-dest": "1",
                "data-iconid": "",
                "data-subchoose": ""
              },
              "description": "派一名同伴进入"
            },
            {
              "attributes": {
                "class": "choose",
                "data-type": "simple",
                "data-title": "尝试探索树的源头",
                "data-icon": "adventure",
                "data-dest": "2",
                "data-iconid": "",
                "data-subchoose": ""
              },
              "description": "派一名同伴探索"
            },
            {
              "attributes": {
                "class": "choose",
                "data-type": "simple",
                "data-title": "休息",
                "data-icon": "population",
                "data-dest": "3",
                "data-iconid": "",
                "data-subchoose": ""
              },
              "description": "获得2希望，在此处养精蓄锐"
            }
          ]
        },
        {
          "scene_number_zero_based": 1,
          "attributes": {
            "class": "scene",
            "data-nav": "探索内部",
            "data-image": "Avg_pic_rogue_6_22",
            "data-name": "未涉足之树",
            "data-ename": "",
            "data-index": "131",
            "data-prtsinfo": ""
          },
          "description": "树干上出现了一个像门一样的缺口，看上去像是一座……电梯？你的同伴出发了，你好奇地在树下等待，希望得知电梯会到达哪里。",
          "choices": []
        },
        {
          "scene_number_zero_based": 2,
          "attributes": {
            "class": "scene",
            "data-nav": "探索源头",
            "data-image": "Avg_pic_rogue_6_22",
            "data-name": "未涉足之树",
            "data-ename": "",
            "data-index": "132",
            "data-prtsinfo": ""
          },
          "description": "树干上的纹理看上去像是某种奇妙的电路图，它们似乎通向大树的核心处。你的同伴出发了，它沿着那些奇妙的纹路追踪，说不定能够找到这个电梯装置的设计者，弄明白那家伙的意图。",
          "choices": [
            {
              "attributes": {
                "class": "choose",
                "data-type": "simple",
                "data-title": "你们约好了会合的地点",
                "data-icon": "leave",
                "data-dest": "",
                "data-iconid": "",
                "data-subchoose": ""
              },
              "description": "或许会有意想不到的发现"
            },
            {
              "attributes": {
                "class": "choose",
                "data-type": "desc",
                "data-title": "",
                "data-icon": "",
                "data-dest": "",
                "data-iconid": "",
                "data-subchoose": ""
              },
              "description": "通过此方式送出的干员不会被进阶。\n回归时，仅获得2希望与收藏品 \nNo.227 怦然信标"
            }
          ]
        },
        {
          "scene_number_zero_based": 3,
          "attributes": {
            "class": "scene",
            "data-nav": "结束",
            "data-image": "Avg_pic_rogue_6_22",
            "data-name": "未涉足之树",
            "data-ename": "",
            "data-index": "133",
            "data-prtsinfo": ""
          },
          "description": "你决定先不去探察，至少这里温暖又安全，在休息一会儿后便离开了。",
          "choices": []
        }
      ],
      "root_return_explanation": "通过此方式送出的干员不会被进阶。\n回归时，仅获得2希望与收藏品 \nNo.227 怦然信标",
